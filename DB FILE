CREATE TABLE book (
    LR Number INT PRIMARY KEY AUTO_INCREMENT,
    TO-PAY/PAID VARCHAR(10),
    booking_date DATE,
    from_location VARCHAR(100),
    to_location VARCHAR(100),
    Sender_Name VARCHAR(10),
    Sender_contact VARCHAR(15),
    Sender_gst VARCHAR(100),
    sender_address VARCHAR(100),
    To_Name VARCHAR(10),
    To_contact VARCHAR(15),
    To_gst VARCHAR(100),
    To_address VARCHAR(100),
    Article_qty int(100),
    Article_goods VARCHAR(100),
    Article_weight Decimal(10,2),
    Charges Decimal(10,2),
    actual_wt Decimal(10,2),
    charged_wt Decimal(10,2),
    wt_rate Decimal(10,2),
    wt_amt Decimal(10,2),
    fix_amt Decimal(10,2),
    invoice int(100),
    declared_val int(100),
    remarks VARCHAR(100),
    delivery_at Godown,Office,Party VARCHAR(100),
    booked-by VARCHAR(100)
)
